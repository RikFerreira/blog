# Backup of the previous Hugo site and the frontend handoff. Kept on disk as a
# reference while the content is rebuilt; never versioned.
archive/

# Handoff archive from the frontend agent.
rikalves_frontend_handoff.zip

# The rendered site. Built inside the image, not committed.
frontend/site/

# Third-party scripts fetched at build time.
frontend/**/vendor/

